{
    "manifest_version": 3,
    "name": "LinkedIn Candidate Analysis",
    "version": "1.0.0",
    "description": "An extension to give match scores based on a candidate's fit for a job.",
    "icons": {
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "48": "images/icon-48.png",
            "128":"images/icon-128.png"
        }
    }
}